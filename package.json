{
  "name": "graph-explorer",
  "version": "3.3.0",
  "private": true,
  "description": "Graph Explorer",
  "license": "Apache-2.0",
  "author": "amazon",
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "lint": "vp lint --fix",
    "check:lint": "vp lint",
    "format": "vp fmt",
    "check:format": "vp fmt --check",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "checks": "vp check",
    "start": "pnpm --filter \"graph-explorer-proxy-server\" run start",
    "clean": "pnpm --stream -r run clean",
    "clean:dep": "rm -rf node_modules && pnpm -r exec rm -rf node_modules",
    "build": "pnpm --stream -r run build",
    "dev": "pnpm --stream -r run dev"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "5.104.5",
    "eslint-plugin-baseline-js": "0.7.5",
    "eslint-plugin-es-x": "10.1.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.8.1"
}
