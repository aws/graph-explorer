---
import { LinkButton } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hero">
	<div class="stack">
		<div class="copy">
			<h1 id="_top" data-page-title set:html={title} />
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(({ icon, link: href, text, variant, attrs }) => (
						<LinkButton href={href} variant={variant} icon={icon?.name} iconPlacement={attrs?.iconPlacement || 'end'}>
							{text}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>
</div>

<style>
	.hero {
		display: flex;
		justify-content: center;
		padding-block: clamp(0.5rem, calc(3vmin - 0.5rem), 2rem) clamp(1.5rem, calc(0.5rem + 3vmin), 3rem);
	}

	.stack {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		width: 100%;
		max-width: 72rem;
		padding-inline: 2rem;
		text-align: start;
		align-items: flex-start;
	}

	.copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: flex-start;
	}

	.copy > * {
		max-width: 40rem;
	}

	h1 {
		font-size: clamp(2rem, calc(1rem + 3.5vw), 3.25rem);
		line-height: var(--sl-line-height-headings);
		font-weight: 800;
		color: var(--sl-color-white);
		letter-spacing: -0.03em;
	}

	.tagline {
		font-size: clamp(1.0625rem, calc(1rem + 0.4vw), 1.25rem);
		color: var(--sl-color-gray-2);
	}

	.actions {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		justify-content: flex-start;
	}
</style>
