---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { LinkButton } from "@astrojs/starlight/components";

// The 404 is served at any depth, so a relative link would resolve against the missing URL.
const home = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<StarlightPage
  frontmatter={{
    title: "Page not found",
    description: "The page you were looking for does not exist.",
    template: "splash",
    pagefind: false,
  }}
>
  <div class="not-found">
    <p class="lead">The link may be out of date, or the page may have moved. Try the search, or start from the docs home.</p>
    <LinkButton href={home} variant="primary">Go to the docs home</LinkButton>
    <p class="report">
      Followed a link on this site? <a href="https://github.com/aws/graph-explorer/issues/new/choose">Report the broken link</a>.
    </p>
  </div>
</StarlightPage>

<style>
  /* One centered block: the title panel and the content panel read as a single group. */
  :global(main):has(.not-found) {
    text-align: center;
    padding-block-start: clamp(2rem, 12vh, 8rem);
  }

  :global(main):has(.not-found) :global(.content-panel + .content-panel) {
    border-top: none;
    padding-block-start: 0;
  }

  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .not-found p {
    margin: 0;
    max-width: 32rem;
    text-wrap: pretty;
  }

  .lead {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
  }

  .report {
    margin-block-start: 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
