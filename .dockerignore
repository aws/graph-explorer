# Avoid copying node_modules to fix issue with esbuild working on a macOS computer with an ARM processor 
# More info: https://esbuild.github.io/getting-started/#simultaneous-platforms
node_modules

# Ignore development related files
.git
.github
.vite-hooks
.vscode
.scratch
.agents
.claude
.kiro
.zed

# Ignore documentation related files
docs
# The lockfile lists the docs site, so its manifest stays for vp install
# --frozen-lockfile. The site itself never goes into the image.
packages/docs/*
!packages/docs/package.json
images
*.md

# Ignore local dev artifacts that may contain secrets or stale build output.
# packages/graph-explorer/.env is a tracked default the image ships, so only
# the gitignored local-override variant is excluded here. Likewise
# cert-info/cert.conf and csr.conf are tracked templates that certificate
# generation reads at startup; only the generated cert material is excluded.
**/.env.local
**/defaultConnection.json
**/cert-info/*.key
**/cert-info/*.crt
**/cert-info/*.csr
**/cert-info/*.srl
**/*.local.*
**/dist

# Tests and their helpers. The build bundles only what the client imports, and
# the server image ships src as-is, so leaving these out keeps them out of the
# image and keeps a test-only edit from invalidating the build layer.
**/*.test.ts
**/*.test.tsx
**/setupTests.ts
**/test-setup.ts
**/testing.ts
**/deployment-scenarios.ts
**/testing
samples
