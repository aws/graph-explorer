# Avoid copying node_modules to fix issue with esbuild working on a macOS computer with an ARM processor 
# More info: https://esbuild.github.io/getting-started/#simultaneous-platforms
node_modules

# Ignore development related files
.git
.github
.husky
.vscode
coverage
.scratch
.agents
.claude
.kiro
.zed

# Ignore documentation related files
docs
images
*.md

# Ignore local dev artifacts that may contain secrets or stale build output.
# packages/graph-explorer/.env is a tracked default and docker-entrypoint.sh
# requires it to exist, so only the gitignored local-override variant is
# excluded here. Likewise cert-info/cert.conf and csr.conf are tracked
# templates setup-ssl.sh needs at runtime; only the generated cert material
# is excluded.
**/.env.local
**/defaultConnection.json
**/cert-info/*.key
**/cert-info/*.crt
**/cert-info/*.csr
**/cert-info/*.srl
**/*.local.*
**/dist
